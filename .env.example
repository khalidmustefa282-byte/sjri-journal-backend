# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sjri"
# openssl rand -base64 32
NEXTAUTH_SECRET=""
# Created automatically when a Vercel Blob store is connected. Leave empty locally (files go to ./.uploads).
BLOB_READ_WRITE_TOKEN=""
# Website addresses allowed to call the API (comma separated)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8080"
NEXT_PUBLIC_FRONTEND_URL="https://sjri-publish-hub.vercel.app"
